# Documented overrides; export them in your shell (no .env loader).
PORT=4317
DAYBREAK_DB=.data/daybreak-v2.sqlite
# auto | jev | anthropic | openai | ollama | baseline
DAYBREAK_PROVIDER=auto

# TypeSafe Jev (typed decision model)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# Any OpenAI-compatible API (OpenAI, OpenRouter, Groq, vLLM, LM Studio)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
